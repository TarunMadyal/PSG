# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
# Note: pubspec.lock IS committed — this is an application, so we want
# reproducible dependency resolution across machines and CI.

# Generated code: we DO commit Drift/build_runner output (*.g.dart) so a fresh
# clone builds and tests without first running code generation. Only mock files
# are regenerated per-run.
*.mocks.dart

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS
.DS_Store
Thumbs.db

# Secrets / env (never commit Supabase keys etc.)
.env
.env.*
!.env.example
**/secrets.dart

# Android
android/.gradle/
android/captures/
android/local.properties
android/key.properties
*.keystore
*.jks

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Coverage
coverage/
